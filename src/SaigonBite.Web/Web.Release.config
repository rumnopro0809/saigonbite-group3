<?xml version="1.0" encoding="utf-8"?>
<!-- Applied by Visual Studio Publish (Release). Web.config stays the local development configuration. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <!-- Never treat signed-out visitors as Admin on a public server (NFR04). -->
    <add key="Uc02:DevAdminFallback" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <!-- Show the generic error page to visitors instead of stack traces. -->
    <customErrors mode="RemoteOnly" xdt:Transform="Insert" />
  </system.web>
</configuration>
