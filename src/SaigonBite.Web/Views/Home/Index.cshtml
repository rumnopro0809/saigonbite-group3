@model SaigonBite.Web.Models.HomeViewModel
@{
    bool isVi = Model.Lang == "vi";
    ViewBag.Title = isVi ? "Trang chủ" : "Home";
    string authNotice = TempData["AuthNotice"] as string;
}

@if (!string.IsNullOrEmpty(authNotice))
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @authNotice
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<section class="sb-hero p-4 p-md-5 mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <span class="badge text-bg-light text-danger mb-2">
                @(isVi ? "BẾP SÀI GÒN · GIAO TẬN CỬA" : "SAIGON CLOUD KITCHENS · FRESH DELIVERY")
            </span>
            <h1 class="display-5 fw-bold mb-3">
                @(isVi ? "Sài Gòn lên món." : "Saigon dishes, cooked to order.")
            </h1>
            <p class="lead mb-3">
                @(isVi
                    ? "Chọn một bếp đám mây gần bạn, gom nhiều thương hiệu trong một đơn với giá minh bạch."
                    : "Pick a nearby cloud-kitchen hub and order across multiple Saigon brands in one checkout.")
            </p>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <a class="btn btn-sb-primary px-4" href="@Url.Action("Create", "Orders")">
                    @(isVi ? "Đặt món ngay" : "Order Now")
                </a>
                @if (Model.IsHeavyRainOn)
                {
                    <span class="badge text-bg-warning py-2 px-3">
                        @(isVi ? "Phụ thu mưa lớn đang bật (+10.000 đ)" : "Heavy rain surcharge is active (+10,000 VND)")
                    </span>
                }
            </div>
        </div>
        <div class="col-lg-5 text-center">
            <img src="@Url.Content("~/Content/images/hero.jpg")"
                 alt="SaigonBite Hero"
                 class="img-fluid rounded-4 shadow-sm"
                 style="max-height: 260px; width: 100%; object-fit: cover;" />
        </div>
    </div>
</section>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-end mb-3">
        <div>
            <h2 class="h4 fw-bold mb-1">@(isVi ? "Các bếp đang hoạt động" : "Active Kitchen Hubs")</h2>
            <p class="text-muted small mb-0">
                @(isVi ? "Chọn bếp gần bạn để đặt món từ các thương hiệu bên trong." : "Choose a nearby hub to browse and order its brands.")
            </p>
        </div>
        <span class="badge text-bg-success">@Model.Hubs.Count @(isVi ? "bếp" : "hubs")</span>
    </div>

    <div class="row g-3">
        @foreach (var hub in Model.Hubs)
        {
            <div class="col-md-4">
                <div class="card h-100 sb-card shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h3 class="h6 fw-bold mb-0">@hub.Name</h3>
                            <span class="badge text-bg-light border">@hub.District</span>
                        </div>
                        <p class="text-muted small mb-2 flex-grow-1">@hub.Address</p>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="small fw-semibold text-success">
                                @(isVi ? "Công suất:" : "Capacity:") @hub.MaxCapacity
                            </span>
                            <a class="btn btn-sm btn-danger" href="@Url.Action("Create", "Orders", new { hubId = hub.Id })">
                                @(isVi ? "Đặt tại bếp này" : "Order here")
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<section>
    <div class="d-flex justify-content-between align-items-end mb-3">
        <div>
            <h2 class="h4 fw-bold mb-1">@(isVi ? "Thực đơn đặc trưng Sài Gòn" : "Signature Saigon Menu")</h2>
            <p class="text-muted small mb-0">
                @(isVi ? "Những món được yêu thích nhất từ các thương hiệu của SaigonBite." : "Favourite dishes from the SaigonBite brands.")
            </p>
        </div>
        <span class="badge text-bg-danger">@Model.MenuItems.Count @(isVi ? "món" : "items")</span>
    </div>

    <div class="row g-4">
        @foreach (var item in Model.MenuItems)
        {
            <div class="col-sm-6 col-lg-3">
                <div class="card h-100 sb-card shadow-sm overflow-hidden">
                    <img src="@Url.Content("~" + item.ImageUrl)"
                         alt="@item.Name"
                         class="card-img-top"
                         style="height: 170px; object-fit: cover;" />
                    <div class="card-body d-flex flex-column">
                        <div class="text-uppercase text-danger fw-bold" style="font-size: 0.72rem;">
                            @(item.Brand != null ? item.Brand.Name : "SaigonBite")
                        </div>
                        <h3 class="h6 fw-bold mt-1 mb-1">@item.Name</h3>
                        <p class="text-muted small flex-grow-1 mb-2">@item.Description</p>
                        <div class="fw-bold fs-6">@string.Format("{0:N0} đ", item.Price)</div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
