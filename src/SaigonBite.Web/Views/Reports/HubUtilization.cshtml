@model HubReportVm
@{
    ViewBag.Title = "R2 · Báo cáo hiệu suất bếp";
    ViewBag.ActiveTab = "r2";
}

<div class="sb-eyebrow">SAIGONBITE / VẬN HÀNH</div>
<h1 class="sb-h1">R2 · Báo cáo hiệu suất bếp</h1>
<p class="sb-sub">Theo dõi số đơn xử lý, thời gian chuẩn bị, tải hiện tại và số lượt ưu đãi theo bếp.</p>

<div class="sb-presets">
    @foreach (var p in Model.Presets)
    {
        <a class="btn @(p.From == Model.From && p.To == Model.To ? "sb-btn-primary" : "sb-btn-outline")"
           href="@Url.Action("HubUtilization", "Reports", new { from = p.From, to = p.To })">@p.Label</a>
    }
    @* Chọn khoảng ngày tùy ý. Ngày kết thúc được tính trọn ngày, theo giờ Việt Nam. *@
    <form method="get" action="@Url.Action("HubUtilization", "Reports")" class="sb-range">
        <label for="from" class="visually-hidden">Từ ngày</label>
        <input type="date" id="from" name="from" value="@Model.From" class="form-control form-control-sm" />
        <span>–</span>
        <label for="to" class="visually-hidden">Đến ngày</label>
        <input type="date" id="to" name="to" value="@Model.To" class="form-control form-control-sm" />
        <button type="submit" class="btn sb-btn-outline btn-sm">Chọn khoảng ngày</button>
    </form>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else
{
    var report = Model.Report;
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="sb-card sb-stat"><div class="sb-stat-label">Bếp theo dõi</div><div class="sb-stat-value">@report.HubCount</div><div class="sb-muted">Tất cả bếp đang theo dõi</div></div>
        </div>
        <div class="col-md-4">
            <div class="sb-card sb-stat"><div class="sb-stat-label">Đơn đã xử lý</div><div class="sb-stat-value">@report.TotalHandled</div><div class="sb-muted">Đơn từng đạt Confirmed trong kỳ</div></div>
        </div>
        <div class="col-md-4">
            <div class="sb-card sb-stat"><div class="sb-stat-label">Lượt ưu đãi bếp vắng</div><div class="sb-stat-value">@report.TotalQuietGranted</div><div class="sb-muted">Đếm theo ưu đãi ghi nhận lúc đặt</div></div>
        </div>
    </div>

    <div class="sb-card">
        <table class="table sb-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Bếp</th>
                    <th>Đơn đã xử lý</th>
                    <th>Chuẩn bị trung bình</th>
                    <th>Tải hiện tại</th>
                    <th>Lượt ưu đãi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in report.Rows)
                {
                    <tr>
                        <td><strong>@row.HubName</strong></td>
                        <td>@row.HandledCount</td>
                        <td>
                            @if (row.AveragePrepMinutes.HasValue)
                            {
                                <text>@(Math.Round(row.AveragePrepMinutes.Value, 0, MidpointRounding.AwayFromZero)) phút</text>
                            }
                            else
                            {
                                @* Không có đơn đủ cặp Confirmed/Ready thì báo "chưa có dữ liệu", không hiện 0 phút. *@
                                <span class="sb-muted">Chưa có dữ liệu</span>
                            }
                        </td>
                        <td><span class="@HubDisplay.LoadCss(row.CurrentLoadLevel)">@row.CurrentLoadPercent%</span></td>
                        <td>@row.QuietGrantedCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="sb-muted mt-3">Thời gian chuẩn bị tính từ Confirmed đến Ready. Tải hiện tại lấy tại thời điểm xem, theo quy tắc BR8.</p>
}
