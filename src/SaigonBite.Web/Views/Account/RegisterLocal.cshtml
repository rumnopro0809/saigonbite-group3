@model SaigonBite.Web.Models.RegisterLocalViewModel
@{
    bool isVi = Model.Lang == "vi";
    ViewBag.Title = isVi ? "Đăng ký Khách nội địa" : "Register Local Customer";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card sb-card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 fw-bold mb-1">@(isVi ? "Đăng ký Khách nội địa" : "Local Customer Registration")</h1>
                <p class="text-muted small mb-3">
                    @(isVi ? "Đăng ký bằng số điện thoại Việt Nam 10 số và mã OTP. Thanh toán bằng MoMo, VNPay hoặc tiền mặt khi nhận hàng." : "Sign up with a 10-digit Vietnamese phone number and an OTP code. Pay with MoMo, VNPay or cash on delivery.")
                </p>

                @using (Html.BeginForm("RegisterLocal", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    if (!ViewData.ModelState.IsValid)
                    {
                        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger small" })
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">@(isVi ? "Họ và tên *" : "Full Name *")</label>
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", maxlength = 120, required = "required" })
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@(isVi ? "Số điện thoại Việt Nam *" : "Vietnamese Mobile Number *")</label>
                        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", placeholder = "0901234567", required = "required" })
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@(isVi ? "Mật khẩu (tối thiểu 8 ký tự) *" : "Password (min 8 chars) *")</label>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", minlength = 8, required = "required" })
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@(isVi ? "Mã OTP *" : "OTP Code *")</label>
                        @Html.TextBoxFor(m => m.OtpCode, new { @class = "form-control", required = "required" })
                    </div>
                    <button type="submit" class="btn btn-sb-primary w-100">@(isVi ? "Tạo tài khoản" : "Create Account")</button>
                }
            </div>
        </div>
    </div>
</div>
