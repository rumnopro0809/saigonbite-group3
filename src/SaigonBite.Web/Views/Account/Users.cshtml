@model SaigonBite.Web.Models.AdminUsersViewModel
@{
    bool isVi = Model.Lang == "vi";
    ViewBag.Title = isVi ? "Quản lý tài khoản" : "User Accounts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <div class="text-uppercase text-danger fw-bold small">SAIGONBITE / @(isVi ? "QUẢN TRỊ" : "ADMIN")</div>
        <h1 class="h3 fw-bold mb-1">@(isVi ? "Quản lý tài khoản người dùng" : "User Account Management")</h1>
        <p class="text-muted small mb-0">
            @(isVi ? "Tài khoản khách nội địa và khách du lịch của SaigonBite." : "SaigonBite local customer and tourist accounts.")
        </p>
    </div>
    <a class="btn btn-secondary sb-act" href="@Url.Action("Users", "Account", new { includeDeleted = !Model.IncludeDeleted })">
        @(Model.IncludeDeleted ? (isVi ? "Ẩn đã xóa mềm" : "Hide soft-deleted") : (isVi ? "Hiện đã xóa mềm" : "Show soft-deleted"))
    </a>
</div>

<div class="card sb-card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@(isVi ? "Định danh" : "Identifier")</th>
                    <th>@(isVi ? "Họ tên" : "Full Name")</th>
                    <th>@(isVi ? "Vai trò" : "Role")</th>
                    <th>@(isVi ? "Hồ sơ" : "Profile")</th>
                    <th>@(isVi ? "Trạng thái" : "Status")</th>
                    <th class="text-end">@(isVi ? "Thao tác" : "Action")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    string profileInfo = "-";
                    if (u.LocalProfile != null) { profileInfo = "Local · " + u.LocalProfile.Phone; }
                    else if (u.TouristProfile != null) { profileInfo = "Tourist · " + u.TouristProfile.PassportNumber + " (" + u.TouristProfile.Nationality + ")"; }
                    else if (u.StaffProfile != null) { profileInfo = "Hub #" + u.StaffProfile.HubId; }

                    <tr class="@(u.IsDeleted ? "table-secondary text-muted" : "")">
                        <td class="fw-semibold">@u.Identifier</td>
                        <td>@u.FullName</td>
                        <td><span class="badge text-bg-light border">@u.Role</span></td>
                        <td class="small">@profileInfo</td>
                        <td>
                            @if (u.IsDeleted)
                            {
                                <span class="badge text-bg-secondary">@(isVi ? "Đã xóa mềm" : "Soft-deleted")</span>
                            }
                            else if (u.IsActive)
                            {
                                <span class="badge text-bg-success">@(isVi ? "Hoạt động" : "Active")</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning text-dark">@(isVi ? "Đã khóa" : "Locked")</span>
                            }
                        </td>
                        <td class="text-end sb-col-actions">
                            <div class="sb-actions">
                                @if (!u.IsDeleted && u.Role != SaigonBite.Domain.ActorRole.Admin)
                                {
                                    using (Html.BeginForm("ToggleUserActive", "Account", new { id = u.Id, isActive = !u.IsActive }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn sb-act @(u.IsActive ? "btn-warning" : "btn-success")">
                                            @(u.IsActive ? (isVi ? "Khóa" : "Lock") : (isVi ? "Mở khóa" : "Unlock"))
                                        </button>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
