@model SaigonBite.Web.Models.LoginViewModel
@{
    bool isVi = Model.Lang == "vi";
    ViewBag.Title = isVi ? "Đăng nhập" : "Sign In";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card sb-card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 fw-bold mb-1">@(isVi ? "Đăng nhập SaigonBite" : "Sign In to SaigonBite")</h1>
                <p class="text-muted small mb-3">
                    @(isVi ? "Dùng email hoặc SĐT đã đăng ký (mật khẩu mẫu seed: Saigon123!)." : "Use registered email or phone (seeded demo password: Saigon123!).")
                </p>

                @using (Html.BeginForm("Login", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    if (!ViewData.ModelState.IsValid)
                    {
                        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger small" })
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">@(isVi ? "Email hoặc SĐT" : "Email or Phone")</label>
                        @Html.TextBoxFor(m => m.Identifier, new { @class = "form-control", placeholder = "admin@saigonbite.vn", required = "required" })
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@(isVi ? "Mật khẩu" : "Password")</label>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", required = "required" })
                    </div>
                    <button type="submit" class="btn btn-sb-primary w-100">@(isVi ? "Đăng nhập" : "Sign In")</button>
                }

                <hr class="my-4" />
                <div class="d-flex justify-content-between small">
                    <a href="@Url.Action("RegisterLocal", "Account")">@(isVi ? "Đăng ký Khách nội địa" : "Register Local Customer")</a>
                    <a href="@Url.Action("RegisterTourist", "Account")">@(isVi ? "Đăng ký Khách du lịch" : "Register Foreign Tourist")</a>
                </div>
            </div>
        </div>
    </div>
</div>
