@model SaigonBite.Web.Models.RegisterTouristViewModel
@{
    bool isVi = Model.Lang == "vi";
    ViewBag.Title = isVi ? "Đăng ký Khách du lịch" : "Register Foreign Tourist";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card sb-card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 fw-bold mb-1">@(isVi ? "Đăng ký Khách du lịch" : "Foreign Tourist Registration")</h1>
                <p class="text-muted small mb-3">
                    @(isVi ? "Đăng ký bằng số hộ chiếu, quốc tịch và email. Thanh toán bằng Apple Pay, PayPal hoặc tiền mặt khi nhận hàng." : "Sign up with your passport number, nationality and email. Pay with Apple Pay, PayPal or cash on delivery.")
                </p>

                @using (Html.BeginForm("RegisterTourist", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    if (!ViewData.ModelState.IsValid)
                    {
                        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger small" })
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">@(isVi ? "Họ và tên *" : "Full Name *")</label>
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", maxlength = 120, required = "required" })
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">@(isVi ? "Số hộ chiếu (6–9 ký tự) *" : "Passport Number (6-9 chars) *")</label>
                            @Html.TextBoxFor(m => m.PassportNumber, new { @class = "form-control text-uppercase", placeholder = "P8821940", required = "required" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">@(isVi ? "Quốc tịch *" : "Nationality *")</label>
                            @Html.TextBoxFor(m => m.Nationality, new { @class = "form-control", placeholder = "Australia", required = "required" })
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email *</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", required = "required" })
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@(isVi ? "Mật khẩu (tối thiểu 8 ký tự) *" : "Password (min 8 chars) *")</label>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", minlength = 8, required = "required" })
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@(isVi ? "Mã xác thực email *" : "Email Verification Code *")</label>
                        @Html.TextBoxFor(m => m.EmailCode, new { @class = "form-control", required = "required" })
                    </div>
                    <button type="submit" class="btn btn-sb-primary w-100">@(isVi ? "Tạo tài khoản" : "Create Account")</button>
                }
            </div>
        </div>
    </div>
</div>
