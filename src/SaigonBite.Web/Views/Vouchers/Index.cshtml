@model SaigonBite.Web.Models.VoucherIndexViewModel
@{
    bool isVi = Model.Lang == "vi";
    ViewBag.Title = isVi ? "Quản lý Voucher (FR15)" : "Manage Vouchers (FR15)";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <div class="text-uppercase text-danger fw-bold small">SAIGONBITE / HT02 · BR9</div>
        <h1 class="h3 fw-bold mb-1">@(isVi ? "Quản lý mã giảm giá (Voucher)" : "Voucher Management")</h1>
        <p class="text-muted small mb-0">
            @(isVi ? "Tối đa 1 voucher hợp lệ mỗi đơn; giảm theo % tính trên (S - Q) có trần Cap, hoặc giảm cố định (BR9)." : "At most one active voucher per order; PERCENT applies to (S - Q) with cap, FIXED is bounded by (S - Q) (BR9).")
        </p>
    </div>
    <a class="btn btn-sb-primary sb-act" href="@Url.Action("Create", "Vouchers")">
        + @(isVi ? "Thêm voucher" : "Add Voucher")
    </a>
</div>

@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-info py-2 px-3 small mb-3">@TempData["StatusMessage"]</div>
}

<div class="mb-3">
    <a class="btn btn-outline-secondary sb-act" href="@Url.Action("Index", "Vouchers", new { includeDeleted = !Model.IncludeDeleted })">
        @(Model.IncludeDeleted ? (isVi ? "Ẩn voucher đã xóa mềm" : "Hide soft-deleted") : (isVi ? "Hiện cả voucher đã xóa mềm" : "Show soft-deleted"))
    </a>
</div>

<div class="card sb-card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@(isVi ? "Mã" : "Code")</th>
                    <th>@(isVi ? "Loại" : "Type")</th>
                    <th class="text-end">@(isVi ? "Giá trị" : "Value")</th>
                    <th class="text-end">@(isVi ? "Trần giảm (Cap)" : "Max Cap")</th>
                    <th class="text-end">@(isVi ? "Đơn tối thiểu (S)" : "Min Subtotal")</th>
                    <th>@(isVi ? "Hiệu lực (UTC+7)" : "Validity")</th>
                    <th>@(isVi ? "Trạng thái" : "Status")</th>
                    <th class="text-end">@(isVi ? "Thao tác" : "Actions")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model.Vouchers)
                {
                    <tr class="@(v.IsDeleted ? "table-secondary text-muted" : "")">
                        <td class="fw-bold">@v.Code</td>
                        <td><span class="badge text-bg-light border">@v.Type</span></td>
                        <td class="text-end">
                            @(v.Type == SaigonBite.Domain.VoucherType.Percent ? string.Format("{0:0.##}%", v.Value) : string.Format("{0:N0} đ", v.Value))
                        </td>
                        <td class="text-end">@string.Format("{0:N0} đ", v.Cap)</td>
                        <td class="text-end">@string.Format("{0:N0} đ", v.MinimumSubtotal)</td>
                        <td class="small">
                            @v.ValidFrom.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy") - @v.ValidTo.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            @if (v.IsDeleted)
                            {
                                <span class="badge text-bg-secondary">@(isVi ? "Đã xóa mềm" : "Soft-deleted")</span>
                            }
                            else if (v.IsActive)
                            {
                                <span class="badge text-bg-success">@(isVi ? "Đang hoạt động" : "Active")</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning text-dark">@(isVi ? "Tạm tắt" : "Inactive")</span>
                            }
                        </td>
                        <td class="text-end sb-col-actions">
                            <div class="sb-actions">
                                @if (!v.IsDeleted)
                                {
                                    <a class="btn btn-outline-primary sb-act" href="@Url.Action("Edit", "Vouchers", new { id = v.Id })">@(isVi ? "Sửa" : "Edit")</a>
                                    using (Html.BeginForm("SoftDelete", "Vouchers", new { id = v.Id }, FormMethod.Post, new { @class = "d-inline", onsubmit = isVi ? "return confirm('Ngưng hiệu lực (soft-delete) voucher này?');" : "return confirm('Soft-delete this voucher?');" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger sb-act">@(isVi ? "Xóa mềm" : "Soft-delete")</button>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
