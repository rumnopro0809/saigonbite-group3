@model SaigonBite.Web.Models.CustomerHubMenuViewModel
@{
    bool isVi = Model.Lang == "vi";
    ViewBag.Title = isVi ? "Thực đơn theo Bếp" : "Browse Menu by Hub";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <div class="text-uppercase text-danger fw-bold small">SAIGONBITE / @(isVi ? "THỰC ĐƠN KHÁCH HÀNG · BR12" : "CUSTOMER MENU · BR12")</div>
        <h1 class="h3 fw-bold mb-1">@(isVi ? "Chọn bếp để xem món đang mở bán" : "Choose a Hub to Browse Available Dishes")</h1>
        <p class="text-muted small mb-0">
            @(isVi ? "Chỉ hiển thị các món Available thuộc thương hiệu đang được Hub đã chọn vận hành (FR09, BR12)." : "Shows only Available items belonging to active brands operated by the selected hub (FR09, BR12).")
        </p>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
    @foreach (var hub in Model.Hubs)
    {
        bool active = hub.Id == Model.SelectedHubId;
        <a class="btn btn-sm @(active ? "btn-sb-primary" : "btn-outline-secondary bg-white")"
           href="@Url.Action("Browse", "Menu", new { hubId = hub.Id })">
            @hub.Name (@hub.District)
        </a>
    }
</div>

@if (Model.SelectedHub != null)
{
    <div class="alert alert-light border small mb-4">
        <strong>@Model.SelectedHub.Name</strong> &middot; @Model.SelectedHub.Address
        <span class="badge text-bg-success ms-2">@Model.Items.Count @(isVi ? "món đang mở bán" : "available items")</span>
    </div>
}

<div class="row g-4">
    @if (Model.Items.Count == 0)
    {
        <div class="col-12">
            <div class="alert alert-warning">
                @(isVi ? "Hiện chưa có món nào đang mở bán tại bếp này." : "No available items are currently served at this hub.")
            </div>
        </div>
    }
    else
    {
        foreach (var item in Model.Items)
        {
            <div class="col-sm-6 col-lg-3">
                <div class="card h-100 sb-card shadow-sm overflow-hidden">
                    <img src="@Url.Content("~" + (string.IsNullOrWhiteSpace(item.ImageUrl) ? "/Content/images/hero.jpg" : item.ImageUrl))"
                         alt="@item.Name"
                         class="card-img-top"
                         style="height: 165px; object-fit: cover;" />
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-uppercase text-danger fw-bold" style="font-size: 0.72rem;">
                                @(item.Brand != null ? item.Brand.Name : "SaigonBite")
                            </span>
                            <span class="badge text-bg-light border">@(item.Brand != null ? item.Brand.Category : "")</span>
                        </div>
                        <h3 class="h6 fw-bold mb-1">@item.Name</h3>
                        <p class="text-muted small flex-grow-1 mb-2">@item.Description</p>
                        <div class="fw-bold">@string.Format("{0:N0} đ", item.Price)</div>
                    </div>
                </div>
            </div>
        }
    }
</div>
