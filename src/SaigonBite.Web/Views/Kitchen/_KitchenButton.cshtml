@model SaigonBite.Web.ViewModels.KitchenButtonModel
@using SaigonBite.Application.Hubs
@using SaigonBite.Web.ViewModels
@using (Html.BeginForm("Act", "Kitchen", FormMethod.Post, new { @class = "m-0" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="orderId" value="@Model.Order.OrderId" />
    <input type="hidden" name="action" value="@Model.Action" />
    <input type="hidden" name="rowVersion" value="@Model.Order.RowVersion" />
    <button type="submit" class="btn sb-act @(Model.Primary ? "btn-sb-primary" : "btn-secondary")">@Model.Label</button>
}
