@model SaigonBite.Infrastructure.Services.KitchenBoard
@using SaigonBite.Application.Hubs
@using SaigonBite.Web.ViewModels
@using SaigonBite.Domain
@using SaigonBite.Infrastructure.Services
@{
    bool en = HubText.IsEnglish(Request);
    ViewBag.Title = en ? "Kitchen board" : "Bảng đơn bếp";
    string ok = TempData["KitchenOk"] as string;
    string error = TempData["KitchenError"] as string;
    Func<OrderStatus, string> statusText = s =>
    {
        switch (s)
        {
            case OrderStatus.Placed: return en ? "New" : "Mới đặt";
            case OrderStatus.Confirmed: return en ? "Confirmed" : "Đã xác nhận";
            case OrderStatus.Preparing: return en ? "Preparing" : "Đang chuẩn bị";
            case OrderStatus.Ready: return en ? "Ready" : "Sẵn sàng giao";
            default: return s.ToString();
        }
    };
}
<link href="@Url.Content("~/Content/uc03.css")" rel="stylesheet" />
<div class="sb-eyebrow">@(en ? "SAIGONBITE / KITCHEN" : "SAIGONBITE / BẾP")</div>
<h1 class="sb-h1">@Model.HubName</h1>
<p class="sb-sub">
    @(en ? "Load" : "Tải bếp"): <strong>@Model.LoadPercent%</strong>
    (@Model.ActiveOrders / @Model.Capacity @(en ? "orders confirmed or preparing" : "đơn đã xác nhận hoặc đang chuẩn bị")).
    @(en ? "New and ready orders do not count toward load." : "Đơn mới đặt và đơn sẵn sàng giao không tính vào tải.")
</p>

@if (ok != null) { <div class="alert alert-success py-2" role="status">@ok</div> }
@if (error != null) { <div class="alert alert-danger py-2" role="alert">@error</div> }

@if (Model.Orders.Count == 0)
{
    <div class="sb-card">@(en ? "No open orders for this hub." : "Bếp chưa có đơn đang xử lý.")</div>
}
else
{
    <div class="row g-3">
        @foreach (var order in Model.Orders)
        {
            <div class="col-12 col-lg-6">
                <div class="sb-card h-100" data-order="@order.OrderCode">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <strong>@order.OrderCode</strong>
                            <div class="small text-muted">@order.PlacedAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <span class="sb-badge badge">@statusText(order.Status)</span>
                    </div>
                    <ul class="mb-2 ps-3">
                        @foreach (var line in order.Lines)
                        {
                            <li>@line.Quantity × @line.Name</li>
                        }
                    </ul>
                    @if (!string.IsNullOrWhiteSpace(order.Notes))
                    {
                        <div class="small mb-1"><strong>@(en ? "Note" : "Ghi chú"):</strong> @order.Notes</div>
                    }
                    <div class="small text-muted mb-3">
                        @order.PaymentMethod · @order.PaymentStatus · @order.PayableTotal.ToString("N0") ₫
                    </div>

                    <div class="d-flex flex-wrap gap-2 align-items-start">
                        @if (order.Status == OrderStatus.Placed)
                        {
                            @Html.Partial("_KitchenButton", new KitchenButtonModel { Order = order, Action = KitchenAction.Confirm, Label = en ? "Confirm" : "Xác nhận", Primary = true })
                        }
                        @if (order.Status == OrderStatus.Confirmed)
                        {
                            @Html.Partial("_KitchenButton", new KitchenButtonModel { Order = order, Action = KitchenAction.StartPreparing, Label = en ? "Start preparing" : "Bắt đầu chuẩn bị", Primary = true })
                        }
                        @if (order.Status == OrderStatus.Preparing)
                        {
                            @Html.Partial("_KitchenButton", new KitchenButtonModel { Order = order, Action = KitchenAction.MarkReady, Label = en ? "Mark ready" : "Báo xong", Primary = true })
                        }
                        @if (order.Status == OrderStatus.Ready)
                        {
                            <span class="small text-muted">@(en ? "Waiting for an admin to assign a shipper." : "Chờ Admin gán shipper.")</span>
                        }
                    </div>

                    @if (order.Status == OrderStatus.Placed)
                    {
                        using (Html.BeginForm("Act", "Kitchen", FormMethod.Post, new { @class = "mt-3 d-flex gap-2" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderId" value="@order.OrderId" />
                            <input type="hidden" name="action" value="@KitchenAction.Reject" />
                            <input type="hidden" name="rowVersion" value="@order.RowVersion" />
                            <input type="text" name="reason" maxlength="300" required class="form-control form-control-sm"
                                   placeholder="@(en ? "Reason for rejecting (required)" : "Lý do từ chối (bắt buộc)")" />
                            <button type="submit" class="btn btn-sm sb-btn-outline">@(en ? "Reject" : "Từ chối")</button>
                        }
                    }
                </div>
            </div>
        }
    </div>
}
