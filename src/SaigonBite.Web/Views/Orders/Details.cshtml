@using System.Linq
@using SaigonBite.Domain
@model SaigonBite.Web.Models.OrderDetailViewModel
@{
    bool isVi = Model.Lang == "vi";
    var o = Model.Order;
    ViewBag.Title = (isVi ? "Chi tiết đơn " : "Order ") + o.OrderCode;
    string badgeClass = o.Status == OrderStatus.Delivered
        ? "text-bg-success"
        : (o.Status == OrderStatus.Cancelled || o.Status == OrderStatus.Failed)
            ? "text-bg-danger"
            : "text-bg-warning";
    bool isOnlinePaid = o.PaymentMethod != PaymentMethod.Cod &&
        string.Equals(o.PaymentStatus, "Paid", System.StringComparison.OrdinalIgnoreCase);
}

@if (!string.IsNullOrEmpty(Model.NoticeMessage))
{
    <div class="alert alert-success">@Model.NoticeMessage</div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <a class="small text-decoration-none text-muted" href="@Url.Action("Index", "Orders")">
            &larr; @(isVi ? "Quay lại danh sách đơn" : "Back to Orders")
        </a>
        <h1 class="h3 fw-bold mt-1 mb-0">
            @o.OrderCode <span class="badge @badgeClass fs-6 align-middle ms-2">@o.Status</span>
        </h1>
    </div>
    <div class="d-flex gap-2">
        @if (Model.CanEdit)
        {
            <a class="btn btn-primary btn-sm fw-semibold"
               href="@Url.Action("Edit", "Orders", new { id = o.Id })">
                @(isVi ? "Sửa món" : "Edit Items")
            </a>
        }
        @if (Model.CanCancel)
        {
            <button type="button" class="btn btn-danger btn-sm fw-semibold"
                    data-bs-toggle="modal" data-bs-target="#cancelOrderModal">
                @(isVi ? "Hủy đơn" : "Cancel Order")
            </button>
        }
    </div>
</div>

@if (Model.CanCancel)
{
    <div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-labelledby="cancelOrderLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                @using (Html.BeginForm("Cancel", "Orders", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" value="@o.Id" />
                    <input type="hidden" name="rowVersionBase64" value="@Model.RowVersionBase64" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="cancelOrderLabel">
                            @(isVi ? "Xác nhận hủy đơn " : "Confirm Cancellation ") @o.OrderCode
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        @if (isOnlinePaid)
                        {
                            <div class="alert alert-info small">
                                @(isVi
                                    ? "Đơn đã thanh toán online qua " + o.PaymentMethod + ". Khi hủy, SaigonBite hoàn lại 100% số tiền " + string.Format("{0:N0} đ", o.PayableTotal) + "."
                                    : "This order was paid online via " + o.PaymentMethod + ". If you cancel, SaigonBite refunds the full " + string.Format("{0:N0} VND", o.PayableTotal) + ".")
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-light border small">
                                @(isVi
                                    ? "Đơn COD chưa thu tiền, hủy đơn không phát sinh hoàn tiền online."
                                    : "COD order has not collected cash yet; no online refund is needed.")
                            </div>
                        }
                        <div class="mb-2">
                            <label class="form-label fw-semibold small" for="cancelReason">
                                @(isVi ? "Lý do hủy đơn (tùy chọn)" : "Cancellation reason (optional)")
                            </label>
                            <input type="text" id="cancelReason" name="reason" class="form-control"
                                   placeholder="@(isVi ? "Ví dụ: Đổi kế hoạch ăn uống" : "e.g. Changed dining plans")" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                            @(isVi ? "Đóng" : "Keep Order")
                        </button>
                        <button type="submit" class="btn btn-danger btn-sm fw-semibold">
                            @(isVi ? "Xác nhận hủy đơn" : "Confirm Cancel")
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card sb-card shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h6 fw-bold mb-3">@(isVi ? "Thông tin đơn hàng" : "Order Information")</h2>
                <div class="row g-2 small">
                    <div class="col-sm-6"><strong>@(isVi ? "Bếp:" : "Hub:")</strong> @(o.Hub != null ? o.Hub.Name : "-")</div>
                    <div class="col-sm-6"><strong>@(isVi ? "Thời điểm đặt:" : "Placed at:")</strong> @o.PlacedAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm:ss")</div>
                    <div class="col-sm-6"><strong>@(isVi ? "Địa chỉ:" : "Address:")</strong> @o.DeliveryAddress</div>
                    <div class="col-sm-6"><strong>@(isVi ? "Khoảng cách:" : "Distance:")</strong> @o.DistanceKm.ToString("0.0") km</div>
                    <div class="col-sm-6"><strong>@(isVi ? "Tải bếp lúc đặt:" : "Hub load at order time:")</strong> @string.Format("{0:P0}", o.HubLoadSnapshot)</div>
                    <div class="col-sm-6"><strong>@(isVi ? "Mưa lớn lúc đặt:" : "Heavy rain at order time:")</strong> @(o.HeavyRainSnapshot ? (isVi ? "Có (+10.000 đ)" : "Yes (+10,000)") : (isVi ? "Không" : "No"))</div>
                    <div class="col-sm-6"><strong>@(isVi ? "Thanh toán:" : "Payment:")</strong> @o.PaymentMethod (@o.PaymentStatus)</div>
                    @if (!string.IsNullOrEmpty(o.Notes))
                    {
                        <div class="col-12"><strong>@(isVi ? "Ghi chú:" : "Notes:")</strong> @o.Notes</div>
                    }
                </div>
            </div>
        </div>

        <div class="card sb-card shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h6 fw-bold mb-3">@(isVi ? "Món đã đặt" : "Ordered Items")</h2>
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@(isVi ? "Món" : "Item")</th>
                            <th class="text-center">@(isVi ? "SL" : "Qty")</th>
                            <th class="text-end">@(isVi ? "Đơn giá lúc đặt" : "Unit Price")</th>
                            <th class="text-end">@(isVi ? "Thành tiền" : "Line Total")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in o.Lines)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@line.ItemNameSnapshot</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">@line.CategorySnapshot</div>
                                </td>
                                <td class="text-center">@line.Quantity</td>
                                <td class="text-end">@string.Format("{0:N0} đ", line.UnitPriceSnapshot)</td>
                                <td class="text-end fw-semibold">@string.Format("{0:N0} đ", line.UnitPriceSnapshot * line.Quantity)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card sb-card shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h6 fw-bold mb-3">@(isVi ? "Lịch sử trạng thái" : "Status History")</h2>
                <ul class="list-group list-group-flush">
                    @foreach (var h in o.StatusHistory.OrderBy(x => x.ChangedAt))
                    {
                        <li class="list-group-item px-0 small">
                            <div class="d-flex justify-content-between">
                                <strong>@(h.FromStatus.HasValue ? h.FromStatus.Value.ToString() : "New") &rarr; @h.ToStatus</strong>
                                <span class="text-muted">@h.ChangedAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM HH:mm:ss")</span>
                            </div>
                            <div class="text-muted">
                                @(h.Actor != null ? h.Actor.FullName : "System")
                                @if (!string.IsNullOrEmpty(h.Reason))
                                {
                                    <span>&middot; @h.Reason</span>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <div class="card sb-card shadow-sm">
            <div class="card-body">
                <h2 class="h6 fw-bold mb-3">@(isVi ? "Chứng từ thanh toán / hoàn tiền" : "Payment Records")</h2>
                <table class="table table-sm mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Operation</th>
                            <th>Method</th>
                            <th>Result</th>
                            <th>CorrelationKey</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in o.Payments.OrderBy(x => x.CreatedAt))
                        {
                            <tr>
                                <td>@p.Operation</td>
                                <td>@p.Method</td>
                                <td>@p.Result</td>
                                <td class="text-muted">@p.CorrelationKey</td>
                                <td class="text-end fw-semibold">@string.Format("{0:N0} đ", p.Amount)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card sb-card shadow-sm border-danger">
            <div class="card-body">
                <h2 class="h6 fw-bold mb-3">@(isVi ? "Tổng kết hóa đơn" : "Price Breakdown")</h2>
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr>
                            <td>@(isVi ? "Tiền món (S)" : "Subtotal (S)")</td>
                            <td class="text-end">@string.Format("{0:N0} đ", o.Subtotal)</td>
                        </tr>
                        <tr>
                            <td>@(isVi ? "Ưu đãi bếp vắng (Q)" : "Quiet discount (Q)")</td>
                            <td class="text-end text-success">-@string.Format("{0:N0} đ", o.QuietDiscount)</td>
                        </tr>
                        <tr>
                            <td>@(isVi ? "Voucher (V)" : "Voucher discount (V)")</td>
                            <td class="text-end text-success">-@string.Format("{0:N0} đ", o.VoucherDiscount)</td>
                        </tr>
                        <tr class="table-light fw-semibold">
                            <td>@(isVi ? "Tiền món sau giảm (F)" : "Food total (F)")</td>
                            <td class="text-end">@string.Format("{0:N0} đ", o.FoodTotal)</td>
                        </tr>
                        <tr>
                            <td>@(isVi ? "Phí giao hàng (D)" : "Delivery fee (D)")</td>
                            <td class="text-end">@string.Format("{0:N0} đ", o.DeliveryFee)</td>
                        </tr>
                        <tr>
                            <td>@(isVi ? "Phụ thu giờ cao điểm (R)" : "Rush fee (R)")</td>
                            <td class="text-end">@string.Format("{0:N0} đ", o.RushFee)</td>
                        </tr>
                        <tr>
                            <td>@(isVi ? "Phụ thu mưa (RainFee)" : "Rain fee")</td>
                            <td class="text-end">@string.Format("{0:N0} đ", o.RainFee)</td>
                        </tr>
                        <tr>
                            <td class="text-muted small">@(isVi ? "Tổng trước làm tròn" : "Raw total")</td>
                            <td class="text-end text-muted small">@string.Format("{0:N0} đ", o.RawTotal)</td>
                        </tr>
                        <tr class="fw-bold fs-5 text-danger">
                            <td>@(isVi ? "Tổng thanh toán" : "Payable Total")</td>
                            <td class="text-end">@string.Format("{0:N0} đ", o.PayableTotal)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
