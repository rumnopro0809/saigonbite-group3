@model HubFormVm
@{
    bool en = HubText.IsEnglish(Request);
    ViewBag.Title = en ? "Edit hub" : "Sửa bếp";
    ViewBag.ActiveTab = "hubs";
}

<div class="sb-eyebrow"><a href="@Url.Action("Details", "Hubs", new { id = Model.Id })">← @(en ? "Hub details" : "Chi tiết bếp")</a></div>
<h1 class="sb-h1">@(en ? "Edit hub" : "Sửa bếp")</h1>
<p class="sb-sub">@(en ? "Lowering capacity can push load above 100% but never changes existing orders." : "Giảm công suất có thể làm tải vượt 100%, nhưng không làm thay đổi các đơn đã có.")</p>

<div class="sb-card sb-form">
    @using (Html.BeginForm("Edit", "Hubs", new { id = Model.Id }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.Partial("_Form", Model)
        <button type="submit" class="btn sb-btn-primary">@(en ? "Save changes" : "Lưu thay đổi")</button>
        <a class="btn sb-btn-outline" href="@Url.Action("Details", "Hubs", new { id = Model.Id })">@(en ? "Cancel" : "Hủy")</a>
    }
</div>
