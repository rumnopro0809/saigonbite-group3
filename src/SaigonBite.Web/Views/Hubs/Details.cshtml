@model HubDto
@using SaigonBite.Application.Hubs
@using SaigonBite.Web.ViewModels
@{
    bool en = HubText.IsEnglish(Request);
    ViewBag.Title = Model.Name;
    ViewBag.ActiveTab = "hubs";
}
<link href="@Url.Content("~/Content/uc03.css")" rel="stylesheet" />

<div class="sb-eyebrow"><a href="@Url.Action("Index", "Hubs")">← @(en ? "Hub list" : "Danh sách bếp")</a></div>
<h1 class="sb-h1">@Model.Name</h1>
<p class="sb-sub">@Model.Location · @Model.District</p>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
<div id="sb-flash" role="status"></div>

@if (!Model.IsActive)
{
    <div class="alert alert-warning">@(en ? "This hub is stopped: it accepts no new orders. Orders already in progress continue." : "Bếp đang ngừng hoạt động: không nhận đơn mới. Các đơn đang chạy vẫn được xử lý tiếp.")</div>
}
@if (Model.Load > 1m)
{
    <div class="alert alert-warning">@(en ? "Current load is above 100% because capacity is lower than the orders in progress. Existing orders are unchanged." : "Tải hiện tại vượt 100% vì công suất đang thấp hơn số đơn đang xử lý. Đơn cũ không bị thay đổi.")</div>
}

<div class="sb-card sb-detail" id="hub-detail" data-active-url="@Url.Action("SetActive", "Hubs", new { id = Model.Id })" data-delete-url="@Url.Action("Delete", "Hubs", new { id = Model.Id })" data-rowversion="@Model.RowVersion" data-active="@(Model.IsActive ? "true" : "false")" data-list-url="@Url.Action("Index", "Hubs")">
    <dl class="row mb-0">
        <dt class="col-sm-3">@(en ? "Status" : "Trạng thái")</dt>
        <dd class="col-sm-9"><span class="@HubDisplay.StatusCss(Model)">@HubDisplay.StatusText(Model, en)</span></dd>

        <dt class="col-sm-3">@(en ? "Capacity" : "Công suất")</dt>
        <dd class="col-sm-9">@(en ? Model.Capacity + " orders at the same time" : Model.Capacity + " đơn cùng lúc")</dd>

        <dt class="col-sm-3">@(en ? "In progress" : "Đang xử lý")</dt>
        <dd class="col-sm-9">@Model.ActiveOrders @(en ? "orders" : "đơn") (Confirmed + Preparing)</dd>

        <dt class="col-sm-3">@(en ? "Current load" : "Tải hiện tại")</dt>
        <dd class="col-sm-9">
            <span class="@HubDisplay.LoadCss(Model.LoadLevel)">@Model.LoadPercent%</span>
            <div class="progress sb-progress mt-2"><div class="progress-bar sb-bar" style="width:@(Model.LoadPercent > 100 ? 100 : Model.LoadPercent)%"></div></div>
        </dd>

        <dt class="col-sm-3">@(en ? "Brands served" : "Brand phục vụ")</dt>
        <dd class="col-sm-9">
            @if (Model.BrandNames.Count == 0)
            {
                <span class="sb-muted">@(en ? "No brand selected" : "Chưa chọn brand nào")</span>
            }
            @foreach (var name in Model.BrandNames)
            {
                <span class="badge sb-badge">@name</span>
            }
        </dd>
    </dl>
</div>

<div class="sb-actions-row">
    <a class="btn btn-outline-primary sb-act" href="@Url.Action("Edit", "Hubs", new { id = Model.Id })">@(en ? "Edit hub" : "Sửa thông tin")</a>
    @* Hai nút dưới gửi POST (có token chống giả mạo) tới HubsController, xem Scripts/uc03.js. *@
    @Html.AntiForgeryToken()
    <button type="button" class="btn sb-act @(Model.IsActive ? "btn-outline-warning" : "btn-outline-success")" data-hub-action="toggle-active">@(Model.IsActive ? (en ? "Stop accepting new orders" : "Ngừng nhận đơn mới") : (en ? "Resume accepting orders" : "Nhận đơn trở lại"))</button>
    <button type="button" class="btn btn-outline-danger sb-act" data-hub-action="delete">@(en ? "Soft-delete" : "Xóa mềm")</button>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/uc03.js")"></script>
}
