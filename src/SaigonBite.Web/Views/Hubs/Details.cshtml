@model HubDto
@{
    ViewBag.Title = Model.Name;
    ViewBag.ActiveTab = "hubs";
    string apiUrl = Url.Content("~/api/hubs/" + Model.Id);
}

<div class="sb-eyebrow"><a href="@Url.Action("Index", "Hubs")">← Danh sách bếp</a></div>
<h1 class="sb-h1">@Model.Name</h1>
<p class="sb-sub">@Model.Location</p>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
<div id="sb-flash" role="status"></div>

@if (!Model.IsActive)
{
    <div class="alert alert-warning">Bếp đang ngừng hoạt động: không nhận đơn mới. Các đơn đang chạy vẫn được xử lý tiếp.</div>
}
@if (Model.Load > 1m)
{
    <div class="alert alert-warning">Tải hiện tại vượt 100% vì công suất đang thấp hơn số đơn đang xử lý. Đơn cũ không bị thay đổi.</div>
}

<div class="sb-card sb-detail" id="hub-detail" data-api="@apiUrl" data-rowversion="@Model.RowVersion" data-active="@(Model.IsActive ? "true" : "false")" data-list-url="@Url.Action("Index", "Hubs")">
    <dl class="row mb-0">
        <dt class="col-sm-3">Trạng thái</dt>
        <dd class="col-sm-9"><span class="@HubDisplay.StatusCss(Model)">@HubDisplay.StatusText(Model)</span></dd>

        <dt class="col-sm-3">Công suất</dt>
        <dd class="col-sm-9">@Model.Capacity đơn cùng lúc</dd>

        <dt class="col-sm-3">Đang xử lý</dt>
        <dd class="col-sm-9">@Model.ActiveOrders đơn (Confirmed + Preparing)</dd>

        <dt class="col-sm-3">Tải hiện tại</dt>
        <dd class="col-sm-9">
            <span class="@HubDisplay.LoadCss(Model.LoadLevel)">@Model.LoadPercent%</span>
            <div class="progress sb-progress mt-2"><div class="progress-bar sb-bar" style="width:@(Model.LoadPercent > 100 ? 100 : Model.LoadPercent)%"></div></div>
        </dd>

        <dt class="col-sm-3">Brand phục vụ</dt>
        <dd class="col-sm-9">
            @if (Model.BrandNames.Count == 0)
            {
                <span class="sb-muted">Chưa chọn brand nào</span>
            }
            @foreach (var name in Model.BrandNames)
            {
                <span class="badge sb-badge">@name</span>
            }
        </dd>
    </dl>
</div>

<div class="sb-actions-row">
    <a class="btn sb-btn-primary" href="@Url.Action("Edit", "Hubs", new { id = Model.Id })">Sửa thông tin</a>
    @* Hai nút dưới gọi REST API (PATCH và DELETE), xem Scripts/uc03.js. *@
    <button type="button" class="btn sb-btn-outline" data-hub-action="toggle-active">@(Model.IsActive ? "Ngừng nhận đơn mới" : "Nhận đơn trở lại")</button>
    <button type="button" class="btn btn-outline-danger" data-hub-action="delete">Xóa bếp</button>
</div>
