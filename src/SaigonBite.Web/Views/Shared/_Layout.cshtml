<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - SaigonBite</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/Content/site.css")" />
</head>
<body>
    @{ string tab = ViewBag.ActiveTab as string; }
    <header class="sb-topbar">
        <div class="sb-logo">SaigonBite</div>
        <span class="sb-pill">QUẢN TRỊ</span>
        <span class="sb-user">Admin · Quận 1</span>
    </header>

    @if (SaigonBite.Web.Security.AdminBypass.IsEnabled)
    {
        <div class="sb-bypass">Chế độ tạm: chưa có đăng nhập (HT01) nên mọi người đều vào được trang quản trị.</div>
    }

    <div class="container sb-container">
        @* Thanh tab giống Figma. Chỉ UC03 và R2 là của phần này, các tab khác chờ UC khác làm. *@
        <nav class="sb-tabs" aria-label="Điều hướng quản trị">
            <span class="sb-tab sb-tab-off" title="Chưa có (UC khác)">Bảng điều khiển</span>
            <span class="sb-tab sb-tab-off" title="Chưa có (UC02)">UC02 · Thực đơn</span>
            <a class="sb-tab @(tab == "hubs" ? "sb-tab-active" : "")" href="@Url.Action("Index", "Hubs")">UC03 · Công suất</a>
            <span class="sb-tab sb-tab-off" title="Chưa có (R1)">R1 · Doanh thu</span>
            <a class="sb-tab @(tab == "r2" ? "sb-tab-active" : "")" href="@Url.Action("HubUtilization", "Reports")">R2 · Hiệu suất bếp</a>
        </nav>

        <main>
            @RenderBody()
        </main>
    </div>

    <script src="@Url.Content("~/Scripts/uc03.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
