@{
    var langCookie = Request.Cookies["sb_lang"];
    string lang = (langCookie != null && langCookie.Value == "en") ? "en" : "vi";
    bool isVi = lang == "vi";
    string toggleLang = isVi ? "en" : "vi";
    string currentUrl = Request.RawUrl ?? "/";
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - SaigonBite</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        :root {
            --sb-paper: #FFFCF5;
            --sb-red: #AC291D;
            --sb-red-dark: #861B14;
            --sb-brown: #291B16;
            --sb-butter: #FFD568;
            --sb-line: #E9DDD0;
        }
        body {
            background-color: var(--sb-paper);
            color: var(--sb-brown);
        }
        .sb-navbar {
            background-color: #FFFFFF;
            border-bottom: 1px solid var(--sb-line);
        }
        .sb-brand {
            color: var(--sb-red-dark) !important;
            font-weight: 800;
            letter-spacing: -0.02em;
        }
        .btn-sb-primary {
            background-color: var(--sb-red);
            border-color: var(--sb-red);
            color: #FFFFFF;
            font-weight: 600;
        }
        .btn-sb-primary:hover {
            background-color: var(--sb-red-dark);
            border-color: var(--sb-red-dark);
            color: #FFFFFF;
        }
        .sb-hero {
            background-color: var(--sb-butter);
            border-radius: 1rem;
        }
        .sb-card {
            border-color: var(--sb-line);
            border-radius: 0.85rem;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg sb-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand sb-brand d-flex align-items-center gap-2" href="@Url.Action("Index", "Home")">
                <img src="@Url.Content("~/Content/images/logo.png")" alt="SaigonBite" width="32" height="32" class="rounded-circle object-fit-cover" />
                <span>SaigonBite</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" href="@Url.Action("Index", "Home")">@(isVi ? "Trang chủ" : "Home")</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" href="@Url.Action("Browse", "Menu")">@(isVi ? "Thực đơn theo Bếp" : "Hub Menu")</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" href="@Url.Action("Index", "Menu")">@(isVi ? "UC02 · Thực đơn" : "UC02 · Menu")</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" href="@Url.Action("Index", "Brands")">@(isVi ? "UC02 · Thương hiệu" : "UC02 · Brands")</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" href="@Url.Action("Index", "Vouchers")">@(isVi ? "Voucher" : "Vouchers")</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-2">
                    <a class="btn btn-sm btn-outline-secondary"
                       href="@Url.Action("SetLanguage", "Home", new { lang = toggleLang, returnUrl = currentUrl })">
                        @(isVi ? "EN" : "VI")
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="container py-4 border-top mt-5 text-muted small d-flex justify-content-between flex-wrap gap-2">
        <span>SaigonBite Cloud-Kitchen Hub &middot; ASP.NET MVC 5 &amp; EF6 Code First</span>
        <span>Team 3 &middot; 524H0072, 524H0189, 524H0188</span>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
