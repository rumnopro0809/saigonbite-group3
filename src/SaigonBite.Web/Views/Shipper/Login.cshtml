@model SaigonBite.Web.Models.AdminLoginViewModel
@{
    bool en = HubText.IsEnglish(Request);
    ViewBag.Title = en ? "Shipper sign-in" : "Đăng nhập shipper";
}
<div class="sb-eyebrow">@(en ? "SAIGONBITE / DELIVERY" : "SAIGONBITE / GIAO HÀNG")</div>
<h1 class="sb-h1">@(en ? "Shipper sign-in" : "Đăng nhập shipper")</h1>
<p class="sb-sub">@(en ? "For shippers. You only see orders assigned to you." : "Dành cho shipper. Bạn chỉ thấy đơn được gán cho mình.")</p>
<div class="sb-card sb-form">
    @using (Html.BeginForm("Login", "Shipper", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.ReturnUrl)
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2" })
        <div class="mb-3">
            <label class="form-label fw-semibold" for="Identifier">@(en ? "Username" : "Tên đăng nhập")</label>
            @Html.TextBoxFor(m => m.Identifier, new { @class = "form-control", autocomplete = "username", required = "required", autofocus = "autofocus" })
            @Html.ValidationMessageFor(m => m.Identifier, "", new { @class = "text-danger small" })
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold" for="Password">@(en ? "Password" : "Mật khẩu")</label>
            @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "current-password", required = "required" })
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
        </div>
        <button type="submit" class="btn sb-btn-primary">@(en ? "Sign in" : "Đăng nhập")</button>
    }
</div>
