@model SaigonBite.Domain.Entities.Brand
@{
    bool isVi = (ViewData["Lang"] as string) != "en";
    var allHubs = ViewData["Hubs"] as System.Collections.Generic.IList<SaigonBite.Domain.Entities.Hub> ?? new System.Collections.Generic.List<SaigonBite.Domain.Entities.Hub>();
    var linkedHubIds = new System.Collections.Generic.HashSet<int>(Model.HubBrands != null ? Model.HubBrands.Select(hb => hb.HubId) : System.Linq.Enumerable.Empty<int>());
    ViewBag.Title = Model.Name;
}

<div class="mb-3">
    <a class="text-decoration-none small" href="@Url.Action("Index", "Brands")">&larr; @(isVi ? "Quay lại danh sách thương hiệu" : "Back to brands")</a>
    <h1 class="h3 fw-bold mt-1">@Model.Name</h1>
</div>

<div class="card sb-card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-3">
            <dt class="col-sm-3">@(isVi ? "Danh mục" : "Category")</dt>
            <dd class="col-sm-9"><span class="badge text-bg-light border">@Model.Category</span></dd>

            <dt class="col-sm-3">@(isVi ? "Trạng thái" : "Status")</dt>
            <dd class="col-sm-9">
                @if (Model.IsDeleted)
                {
                    <span class="badge text-bg-secondary">@(isVi ? "Đã xóa mềm" : "Soft-deleted")</span>
                }
                else if (Model.IsActive)
                {
                    <span class="badge text-bg-success">@(isVi ? "Đang hoạt động" : "Active")</span>
                }
                else
                {
                    <span class="badge text-bg-warning text-dark">@(isVi ? "Tạm ngưng" : "Inactive")</span>
                }
            </dd>

            <dt class="col-sm-3">@(isVi ? "Bếp vận hành" : "Serving Hubs")</dt>
            <dd class="col-sm-9">
                @foreach (var hub in allHubs.Where(h => linkedHubIds.Contains(h.Id)))
                {
                    <span class="badge text-bg-light border me-1">@hub.Name</span>
                }
            </dd>

            <dt class="col-sm-3">@(isVi ? "Mô tả" : "Description")</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</dd>
        </dl>

        @if (!Model.IsDeleted)
        {
            <a class="btn btn-sb-primary sb-act" href="@Url.Action("Edit", "Brands", new { id = Model.Id })">
                @(isVi ? "Chỉnh sửa thương hiệu" : "Edit Brand")
            </a>
        }
    </div>
</div>

<h2 class="h5 fw-bold mb-2">@(isVi ? "Các món thuộc thương hiệu này" : "Menu Items in this Brand")</h2>
<div class="card sb-card shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@(isVi ? "Tên món" : "Item")</th>
                    <th class="text-end">@(isVi ? "Giá bán" : "Price")</th>
                    <th>@(isVi ? "Trạng thái" : "Status")</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.MenuItems == null || Model.MenuItems.Count == 0)
                {
                    <tr><td colspan="3" class="text-center text-muted py-3">@(isVi ? "Chưa có món ăn nào." : "No items yet.")</td></tr>
                }
                else
                {
                    foreach (var item in Model.MenuItems)
                    {
                        <tr>
                            <td><a href="@Url.Action("Details", "Menu", new { id = item.Id })">@item.Name</a></td>
                            <td class="text-end">@string.Format("{0:N0} đ", item.Price)</td>
                            <td>
                                @(item.IsDeleted ? (isVi ? "Đã xóa mềm" : "Soft-deleted") : (item.IsAvailable ? (isVi ? "Đang bán" : "Available") : (isVi ? "Tạm ngưng" : "Unavailable")))
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
