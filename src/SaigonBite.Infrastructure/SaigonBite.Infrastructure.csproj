<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lớp truy cập dữ liệu: EF6 Code First, migrations và dữ liệu mẫu. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>SaigonBite.Infrastructure</RootNamespace>
    <AssemblyName>SaigonBite.Infrastructure</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SaigonBite.Domain\SaigonBite.Domain.csproj" />
    <ProjectReference Include="..\SaigonBite.Application\SaigonBite.Application.csproj" />
    <PackageReference Include="EntityFramework" Version="6.4.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- EF6 tìm resource theo tên lớp migration (không kèm mã thời gian), nên gắn .resx vào file .cs cùng tên. -->
    <EmbeddedResource Update="Migrations\*.resx" DependentUpon="%(Filename).cs" />
  </ItemGroup>
</Project>
