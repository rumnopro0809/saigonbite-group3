@startuml
title UC01 - Place and Manage Orders\nOverview | FR01-FR07
footer Author: Nguyen Hai Trieu (524H0072) | Team 3
skinparam backgroundColor #FFFCF5
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam activityBackgroundColor #FFF4DF
skinparam activityBorderColor #735344
skinparam activityDiamondBackgroundColor #FFE9A7
skinparam activityDiamondBorderColor #735344
skinparam ArrowColor #735344
start
:Customer requests an order action;
if (Authenticated?) then (yes)
else (no)
 :Request sign-in through account support;
 stop
endif
switch (Requested action)
case (Create)
 :Run Create detail\nFR01-FR04;
 :Validate hub/cart, show price,\nselect allowed payment and save Placed;
case (Read)
 :Run Read detail\nFR05;
 :Check ownership; show stored\ndetails, payment and status history;
case (Edit)
 :Run Edit detail\nFR06 / BR17;
 :Check ownership and Placed;\nreprice from snapshot and save safely;
case (Cancel)
 :Run Cancel detail\nFR07 / BR16;
 :Check ownership and Placed/Confirmed;\nrefund online-paid amount and retain history;
endswitch
:Return success or a specific error\nfrom the selected detail flow;
stop
legend bottom
  Conditions and errors are expanded in four detail diagrams.
  Activity final ends this request, not the lifetime of the Order.
  Payment/pricing proposals remain subject to the Ambiguity Log.
endlegend
@enduml
