@startuml
title UC01 - Read and Track Orders\nFR05 / FR13 | BR15 | NFR04
footer Nguyen Hai Trieu - 524H0072 | Group 3 | AI-assisted draft for owner review
skinparam backgroundColor #FFFCF5
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam activityBackgroundColor #FFF4DF
skinparam activityBorderColor #735344
skinparam activityDiamondBackgroundColor #FFE9A7
skinparam activityDiamondBorderColor #735344
skinparam ArrowColor #735344
|Customer|
start
:Open My Orders;
|System|
if (Authenticated?) then (yes)
else (no)
 :Request sign-in;
 stop
endif
:Query only this customer's orders;
if (Any orders?) then (yes)
 :Display own order list;
else (no)
 :Display empty-order message;
 stop
endif
|Customer|
:Choose an order;
|System|
:Load order and recheck ownership\non the server;
if (Exists and owned by this customer?) then (yes)
else (no)
 :Deny request without exposing\nanother customer's order details;
 stop
endif
:Display stored lines, price breakdown,\npayment status and chronological history;
:Show Edit only for Placed;\nshow Cancel only for Placed/Confirmed;
note right
  Visibility is UI assistance.
  Edit/Cancel detail flows recheck
  ownership and current state on server.
end note
:Return current view;\nno order mutation;
stop
legend bottom
  Kitchen/shipper actions are HT03; results appear in tracking.
  Customers cannot directly set Ready, Delivered or Failed.
endlegend
@enduml
