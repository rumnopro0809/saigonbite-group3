<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <!-- Tests use their own database (created and seeded automatically on the first run) so data entered
       in the web app (SaigonBiteDb) never breaks the exact seed counts checked by DatabaseSeedTests. -->
  <connectionStrings>
    <add name="SaigonBiteDb" connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=SaigonBiteTests;Integrated Security=True;MultipleActiveResultSets=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
</configuration>
